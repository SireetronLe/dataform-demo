config {
    type: "table",
    schema: "silver_t3"
}

SELECT
  t2.date_time,
  t2.value,
  t2.parameter,
  t2.tambon_code,
  tb.tam_nam_t as tambon_name,
  tb.amphoe_t as amphoe_name,
  tb.prov_nam_t as province_name,
  t2.landuse_code,
  tb.geometry
FROM
  ${ref('t2_emission')} as t2
LEFT JOIN
  `database-test-466014.Demo.tambon` as tb
ON
  tb.tam_code = t2.tambon_code
